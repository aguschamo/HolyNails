# URL base del backend Django; se incorpora al bundle durante el build.
# Desarrollo local:
VITE_API_URL=http://127.0.0.1:8000
# En producción mantener desactivado hasta configurar almacenamiento persistente.
VITE_PROFILE_PHOTO_UPLOAD_ENABLED=true
# En Vercel, definir para producción y preview, reemplazando el ejemplo:
# VITE_API_URL=https://tu-api.up.railway.app
# VITE_PROFILE_PHOTO_UPLOAD_ENABLED=false
