# Plantilla local. No guardes valores secretos en este archivo.
# Copialo como .env para el desarrollo local.

# --- Seguridad ---
# Generar una clave nueva para este entorno con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Definirla en .env local y en el entorno de Railway. No reutilizar claves
# entre entornos ni subir valores reales al repositorio.
SECRET_KEY=
# true/false (también acepta 1/0, yes/no, on/off). En Railway: false.
DEBUG=true
# HSTS desactivado inicialmente. Solo evaluar un valor > 0 después de
# verificar HTTPS en producción. Mantener subdominios/preload desactivados.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# No configurar SECURE_PROXY_SSL_HEADER hasta verificar X-Forwarded-Proto
# y el login CSRF del admin detrás del proxy de Railway.
# Orígenes exactos de formularios CSRF; Railway usa el origen HTTPS del backend.
# CSRF_TRUSTED_ORIGINS=https://holynails-production.up.railway.app
# Hosts separados por comas y sin protocolo.
# Railway: dominio público de la API,healthcheck.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Las subidas se habilitan por defecto solo cuando DEBUG=true.
# En Railway mantener en false hasta configurar almacenamiento persistente.
PROFILE_PHOTO_UPLOAD_ENABLED=true

# --- Base de datos ---
# Desarrollo local:
DB_NAME=programacion1_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Railway: definir DATABASE_URL con la referencia al servicio PostgreSQL.
# No copiar credenciales reales a este archivo.
# DATABASE_URL=

# --- CORS ---
# En Railway, permitir el origen HTTPS de Vercel, sin barra final.
# CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
